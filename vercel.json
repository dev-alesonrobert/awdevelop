{
  "framework": null,
  "buildCommand": "npm run build:angular && npm run migrate && npm test && node scripts/verify-management-db.js",
  "outputDirectory": "dist",
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/painel/:path*",
      "destination": "/painel/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "installCommand": "npm ci --include=dev"
}
